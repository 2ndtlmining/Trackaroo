# Trackaroo environment variables
# Copy to .env (gitignored) and fill in overrides. All values optional —
# sensible defaults are baked into config.py / scraper/pccg.py.

# ── Algolia credentials (PCCG scraper) ────────────────────────────────
# The current public read-only search key is the default in scraper/pccg.py.
# Leave these COMMENTED OUT: an uncommented copy pins an old key in .env and
# silently overrides the code default after PCC rotates it (#11). Set them
# only when following DEPLOYMENT.md -> "PCCG key rotation".
# ALGOLIA_APP_ID=HPD3DBJ2IO
# ALGOLIA_API_KEY=9559cf1a6c7521a30ba0832ec6c38499

# ── Paths (config.py) ─────────────────────────────────────────────────
# TRACKAROO_DATA_DIR     Scraped JSON snapshot directory (default <repo>/data)
# TRACKAROO_DB           SQLite database file            (default <repo>/db/trackaroo.db)
#                        NOTE: also honoured by the web frontend (web/src/lib/server/db.ts)
# TRACKAROO_SCHEMA       Schema SQL file                 (default <repo>/db/schema.sql)
# TRACKAROO_WATCHLIST    Watchlist CSV                   (default <repo>/db/watchlist.csv)
# TRACKAROO_BACKUP_DIR   Database backup directory       (default <repo>/db/backups)

# ── Health-check thresholds (config.py) ───────────────────────────────
# TRACKAROO_STALE_THRESHOLD_DAYS        Freshness threshold in days (default 3)
# TRACKAROO_STALE_LISTING_DAYS          Days a listing may go unseen while its retailer
#   stays current before check_stale_listings.py marks it 'stale' (default 7). Compared
#   against the retailer's own latest snapshot, never against now -- see that module's
#   docstring for why comparing against now would mass-mistag a whole retailer's catalogue.
# TRACKAROO_PRICE_ANOMALY_STD_DEVS      Price-anomaly sigma gate (default 3.0)
# TRACKAROO_MIN_HISTORY_FOR_ANOMALY     Min PRIOR points before the sigma test runs (default 10)
#   Below 10 a 3-sigma trip is not unlikely but impossible: with N points the largest
#   reachable z-score is about sqrt(N). A lower value only hides that fact.
# TRACKAROO_PRICE_MOVE_PCT              Day-over-day move flagged on its own (default 0.10)
#   Needs only two points, so it covers listings the sigma test structurally cannot --
#   above all a flat price history, where the prior sigma is 0 and no jump is reachable.
# TRACKAROO_MATCH_THRESHOLDS_JSON       JSON object of per-retailer match thresholds, e.g.
#   {"scorptec":{"min_total":90,"min_per_category":30},"pccg":{"min_total":20,"min_per_category":5}}
# TRACKAROO_DEFAULT_MIN_PER_CATEGORY    Match-count fallback for any retailer not in
#   TRACKAROO_MATCH_THRESHOLDS_JSON (default 5)
# TRACKAROO_DEFAULT_MIN_TOTAL           Match-count fallback for any retailer not in
#   TRACKAROO_MATCH_THRESHOLDS_JSON (default 10)

# ── Scraper tuning (config.py) ────────────────────────────────────────
# TRACKAROO_SCRAPER_TIMEOUT_SECONDS   Per-scraper subprocess timeout (default 300)
# TRACKAROO_BATCH_SIZE                Algolia batch size (default 16)
# TRACKAROO_BATCH_DELAY               Seconds between Algolia batches (default 1.0)
# TRACKAROO_ALGOLIA_TIMEOUT_SECONDS   Algolia HTTP timeout (default 15)
# TRACKAROO_ALGOLIA_MAX_RETRIES       Algolia request retries (default 3)
# TRACKAROO_ALGOLIA_BACKOFF_MAX       Upper bound for exponential backoff (default 20)
# TRACKAROO_ALGOLIA_RATE_LIMIT_WAIT   Base wait on HTTP 429 (default 5)
# TRACKAROO_ALGOLIA_CIRCUIT_BREAKER   Consecutive failed Algolia batches before aborting (default 3)
# TRACKAROO_PCCG_COOLDOWN_HOURS       Cooldown window in hours after breaker trips (default 4)
# TRACKAROO_PCCG_COOLDOWN_FILE        Breaker cooldown state file (default <DATA_DIR>/pccg_cooldown.json)
# TRACKAROO_CATEGORY_PASS_DELAY       Delay in seconds between CPU/GPU category passes (default 2.0)
# TRACKAROO_BUSY_TIMEOUT_MS           SQLite busy timeout (default 5000)
# TRACKAROO_BACKUP_KEEP               Days of DB backups to retain, newest per day (default 14)
# TRACKAROO_SCRAPER_GAP_SECONDS       Delay in seconds between the two scrapers (default 2.0)

# ── Scorptec scraper tuning (config.py) ───────────────────────────────
# TRACKAROO_SCORPTEC_TIMEOUT_SECONDS  Scorptec HTTP timeout (default 15)
# TRACKAROO_SCORPTEC_MAX_RETRIES      Scorptec fetch retries (default 2)
# TRACKAROO_SCORPTEC_RETRY_DELAY      Delay in seconds between Scorptec retries (default 2.0)
# TRACKAROO_SCORPTEC_PAGE_DELAY       Delay in seconds between Scorptec pages (default 0.5)
# TRACKAROO_SCORPTEC_MAX_PAGES        Scorptec pagination safety cap (default 20)
# TRACKAROO_SCORPTEC_DELIST_CHECK_MAX Max stale listing pages check_delisted.py fetches per run (default 100)
# TRACKAROO_SCORPTEC_DELIST_PAGE_DELAY Delay in seconds between delisted-check fetches (default 1.5)

# ── Algolia pagination tuning (config.py) ─────────────────────────────
# TRACKAROO_ALGOLIA_HITS_PER_PAGE     Algolia hits per page (default 20)
# TRACKAROO_ALGOLIA_MAX_PAGES         Algolia pagination safety cap (default 10)
# TRACKAROO_ALGOLIA_BATCH_MAX_PAGES   Page cap for batch searches (default 3)
# TRACKAROO_ALGOLIA_PAGE_DELAY        Delay in seconds between Algolia pages (default 0.3)

# ── Spec sync tuning (config.py) ──────────────────────────────────────
# TRACKAROO_SPEC_FETCH_TIMEOUT        Spec-source fetch timeout (default 20)
# TRACKAROO_SPEC_RETRY_BACKOFF        Delay in seconds between spec fetch retries (default 2.0)
# TRACKAROO_AMD_FETCH_DELAY           Delay in seconds between AMD page fetches (default 1.0)

# ── Discord digest (notify_discord.py) ────────────────────────────────
# run_daily.py posts the biggest daily price moves after a healthy run.
# Create a webhook (Server Settings → Integrations → Webhooks) and set the
# URL below. Both CPU and GPU moves go to the same webhook. With it unset,
# no digest is sent.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Optional: an alert webhook for pipeline issues (a scraper failure or a
# health-check error) — the digest itself is gated on a clean run, so
# failures get their own message here. Omit to skip alerts.
# DISCORD_WEBHOOK_ALERT=https://discord.com/api/webhooks/...

# Hour (0-23, local time) the in-container staleness monitor runs.
# Must be LATER than RETRY_UNTIL_HOUR: before the last hourly retry has had
# its chance, "no data today" is not an outage yet. Without
# DISCORD_WEBHOOK_ALERT above, the check still runs but signals only through
# the container log.
# STALENESS_CHECK_HOUR=10
# Optional: public base URL of the dashboard, adds a "Trackaroo page" link
# to each embed next to the retailer link. Omit for retailer links only.
# TRACKAROO_PUBLIC_BASE_URL=https://trackaroo.example.com

# ── Price-drop & restock alerts (check_alerts.py) ─────────────────────
# Users arm "tell me under $X" alerts from the product page. run_daily.py
# evaluates them after a healthy ingest and delivers via the alert's channel.
# Each channel is optional — an unconfigured channel is silently skipped, so
# with none set, alerts are stored but never delivered.
# channel='discord' → Discord webhook (Server Settings → Integrations → Webhooks):
# TRACKAROO_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# channel='email' → SMTP (STARTTLS on port 587 by default):
# TRACKAROO_SMTP_HOST=smtp.example.com
# TRACKAROO_SMTP_PORT=587
# TRACKAROO_SMTP_USERNAME=you@example.com
# TRACKAROO_SMTP_PASSWORD=app-password
# TRACKAROO_SMTP_FROM=you@example.com
# TRACKAROO_SMTP_TO=you@example.com
# channel='webhook' → any endpoint that accepts POST {title, body}:
# TRACKAROO_ALERT_WEBHOOK_URL=https://example.com/hooks/trackaroo
# TRACKAROO_RESTOCK_COOLDOWN_HOURS      Minimum hours between restock re-fires for the
#   same alert (default 24) -- guards against a double run on the same day re-announcing
#   the same out-of-stock -> in-stock transition.

# ── Notification delivery tuning (check_alerts.py, notify_discord.py) ─
# TRACKAROO_NOTIFY_TIMEOUT_SECONDS      HTTP/SMTP timeout for outbound alert and digest
#   delivery (default 10). These are best-effort, never-raise calls, so this only bounds
#   how long a slow endpoint can hold up the run.

# ── Scheduling & retry (deploy/entrypoint*.sh, run_daily.py) ──────────
# RUN_AT_HOUR=4            Daily run hour, local 0-23
# RETRY_UNTIL_HOUR=9       Failed/incomplete retailers retried hourly until this hour (inclusive).
#                          Keep it EARLIER than STALENESS_CHECK_HOUR.
# SKIP_PIPELINE=0          1 = dashboard only, never scrapes (CI boot test)

# ── Health thresholds added 29-Sep-2026 (config.py) ───────────────────
# TRACKAROO_MATCH_DROP_RATIO=0.6          ERROR when today's listings < ratio x trailing median
# TRACKAROO_MATCH_DROP_WINDOW_DAYS=7      Trailing window for that median
# TRACKAROO_MATCH_DROP_MIN_HISTORY=3      Prior days needed before the rule judges

# ── Off-host monitoring and backups (opt-in) ───────────────────────────
# Opt-in dead-man's-switch ping, sent by run_daily.py only after a run that
# leaves every active retailer complete for the day; a no-op when unset. The
# URL's path is its check's secret (e.g. a healthchecks.io UUID) -- treat it
# like a credential, never commit a real value.
# TRACKAROO_HEARTBEAT_URL=https://hc-ping.com/<uuid>   pinged after a complete, clean day
# Verified off-host copy of every DB backup (a mounted NAS path). The operator
# must create/mount this directory first -- Trackaroo never creates it.
# TRACKAROO_BACKUP_MIRROR_DIR=/mnt/nas/trackaroo       verified copy of every DB backup
#   With compose, mount the share via docker-compose.override.yml and use the
#   container path, e.g. /mnt/trackaroo-mirror
# check_backups warns when the newest backup is older than this.
# TRACKAROO_BACKUP_MAX_AGE_HOURS=36                    backup-age warning threshold