# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env*

# Testing
.pytest_cache/
.coverage
htmlcov/

# Data — live scraped output is volume-mounted at runtime, but the snapshot
# history (data/*.json) is baked into the image to hydrate a fresh DB on boot.
data/*.backup*
data/.backup*/
# Discovery catalogues are a 30-day report, not history to bake into the image.
data/catalogue/
db/backups/
db/*.db
db/*.db-wal
db/*.db-shm

# SvelteKit / web (built inside its own image stage)
web/node_modules/
web/.svelte-kit/
web/build/
web/e2e/e2e.db
web/test-results/
web/playwright-report/

# Git
.git/
.gitignore

# OS
.DS_Store
Thumbs.db